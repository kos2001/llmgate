# Copy to .env. Every variable is optional; names are LLMGATE_<FIELD> (see llmgate/config.py for all of them).

# --- core ---------------------------------------------------------------------------------
LLMGATE_ADMIN_TOKEN=change-me-to-a-long-random-string      # break-glass admin credential
LLMGATE_DATABASE_PATH=data/llmgate.db
LLMGATE_PUBLIC_CATALOG=true                                # false: /api/v1/models, /providers need a key

# --- SSO (OIDC) + JWT ----------------------------------------------------------------------
# LLMGATE_OIDC_ISSUER=https://idp.example.com/realms/corp
# LLMGATE_OIDC_CLIENT_ID=llmgate-dashboard
# LLMGATE_OIDC_CLIENT_SECRET=...
# LLMGATE_OIDC_AUDIENCE=llmgate-api                        # aud expected on IdP JWTs used as bearer tokens
# LLMGATE_OIDC_ROLES_CLAIM=roles                           # dotted path allowed, e.g. realm_access.roles
# LLMGATE_OIDC_ROLE_MAP={"llm-admins":"admin","llm-operators":"operator","llm-viewers":"viewer"}
# LLMGATE_OIDC_DEFAULT_ROLE=none                           # none = reject signed-in users without a mapped group
# LLMGATE_OIDC_ALLOWED_EMAIL_DOMAINS=example.com
# LLMGATE_JWT_SECRET=                                      # >= 32 random chars; unset = random per process
# LLMGATE_COOKIE_SECURE=true                               # behind HTTPS
# LLMGATE_ADMIN_TOKEN_ENABLED=true

# --- router / cache / observability ---------------------------------------------------------
# LLMGATE_UPSTREAM_RETRIES=1
# LLMGATE_COOLDOWN_AFTER_FAILS=3
# LLMGATE_COOLDOWN_S=30
# LLMGATE_CACHE_TTL_S=0                                    # >0 enables the response cache globally
# LLMGATE_USAGE_WEBHOOK_URL=https://collector.example.com/events
# LLMGATE_ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# LLMGATE_HEALTH_INTERVAL_S=30
